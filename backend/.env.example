# Copy to .env and fill in values

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Auth
SECRET_KEY=your-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...           # Your $10-15/month plan price ID

# Quotas
FREE_REQUESTS_PER_MONTH=30
PAID_REQUESTS_PER_MONTH=999999

# Server
ALLOWED_ORIGINS=vscode-webview://,http://localhost:3000
DATABASE_URL=sqlite:///./ldo.db     # Use postgresql:// in production
