{
  "name": "lets-code-ourselves",
  "displayName": "Let's Code Ourselves",
  "description": "AI mentor that makes you think — not a code generator. Socratic learning inside VS Code.",
  "version": "0.1.0",
  "publisher": "lets-code-ourselves",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "learning",
    "mentor",
    "AI",
    "Socratic",
    "junior developer",
    "best practices",
    "no code generation"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ldo.setApiKey",
        "title": "Set OpenAI API Key",
        "category": "Let's Code Ourselves"
      },
      {
        "command": "ldo.attachFile",
        "title": "Attach Current File to Chat",
        "category": "Let's Code Ourselves"
      },
      {
        "command": "ldo.attachSelection",
        "title": "Attach Selected Code to Chat",
        "category": "Let's Code Ourselves"
      },
      {
        "command": "ldo.attachProject",
        "title": "Attach Entire Project to Chat",
        "category": "Let's Code Ourselves"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ldo.attachSelection",
          "when": "editorHasSelection",
          "group": "ldo@1"
        },
        {
          "command": "ldo.attachFile",
          "group": "ldo@2"
        }
      ]
    },
    "configuration": {
      "title": "Let's Code Ourselves",
      "properties": {
        "ldo.openaiModel": {
          "type": "string",
          "default": "gpt-4o",
          "enum": ["gpt-4o", "gpt-4-turbo", "gpt-4", "gpt-3.5-turbo"],
          "description": "OpenAI model used by the mentor"
        },
        "ldo.defaultMode": {
          "type": "string",
          "default": "learn",
          "enum": ["learn", "hint", "emergency"],
          "enumDescriptions": [
            "Pure Socratic method — always responds with questions",
            "Small targeted hints when stuck",
            "Direct conceptual guidance for urgent situations"
          ],
          "description": "Default mentor mode when the extension starts"
        },
        "ldo.maxFileSizeKb": {
          "type": "number",
          "default": 100,
          "description": "Maximum file size in KB to include when attaching files"
        },
        "ldo.excludePatterns": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/*.min.js",
            "**/*.lock",
            "**/package-lock.json"
          ],
          "description": "Glob patterns excluded when attaching the project"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ldo-sidebar",
          "title": "Let's Code Ourselves",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ldo-sidebar": [
        {
          "type": "webview",
          "id": "ldo.advisorView",
          "name": "Mentor"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "openai": "^4.28.0"
  }
}
