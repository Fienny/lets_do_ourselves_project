{
  "name": "lets-code-ourselves",
  "displayName": "Let's Code Ourselves",
  "description": "AI mentor that makes you think — not a code generator.",
  "version": "0.1.0",
  "publisher": "lets-code-ourselves",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Education", "Other"],
  "keywords": ["learning", "mentor", "AI", "Socratic", "junior developer"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ldo.attachFile",
        "title": "Attach Current File to Chat",
        "category": "Let's Code Ourselves"
      },
      {
        "command": "ldo.attachSelection",
        "title": "Attach Selected Code to Chat",
        "category": "Let's Code Ourselves"
      },
      {
        "command": "ldo.attachProject",
        "title": "Attach Entire Project to Chat",
        "category": "Let's Code Ourselves"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ldo.attachSelection",
          "when": "editorHasSelection",
          "group": "ldo@1"
        },
        {
          "command": "ldo.attachFile",
          "group": "ldo@2"
        }
      ]
    },
    "configuration": {
      "title": "Let's Code Ourselves",
      "properties": {
        "ldo.backendUrl": {
          "type": "string",
          "default": "",
          "description": "URL of the Let's Code Ourselves backend (e.g. https://yourdomain.com or http://localhost:8000)"
        },
        "ldo.maxFileSizeKb": {
          "type": "number",
          "default": 100,
          "description": "Max file size in KB when attaching files"
        },
        "ldo.excludePatterns": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/*.min.js",
            "**/*.lock",
            "**/package-lock.json"
          ],
          "description": "Glob patterns excluded when attaching the project"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ldo-sidebar",
          "title": "Let's Code Ourselves",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ldo-sidebar": [
        {
          "type": "webview",
          "id": "ldo.advisorView",
          "name": "Mentor"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {}
}
